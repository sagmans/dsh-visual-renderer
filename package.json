{
  "name": "@local/visual-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Render Mermaid diagrams and SVG graphics inside DeepSeek Harness session transcripts.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "vendor/LICENSE.mermaid",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sagmans/dsh-visual-renderer.git"
  },
  "homepage": "https://github.com/sagmans/dsh-visual-renderer#readme",
  "bugs": {
    "url": "https://github.com/sagmans/dsh-visual-renderer/issues"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/check.mjs smoke"
  },
  "dependencies": {
    "mermaid": "12.2.0"
  }
}
